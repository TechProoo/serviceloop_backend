{
  "name": "serviceloop-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "ts-node src/main.ts",
    "start:prod": "prisma migrate deploy && node dist/src/main.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "admin:promote": "ts-node scripts/promote-admin.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "dotenv": "17.4.1",
    "helmet": "8.1.0",
    "pg": "8.20.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@electric-sql/pglite-socket": "0.0.21",
    "@nestjs/testing": "^11.1.18",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.30",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prisma": "7.10.1",
    "supertest": "^7.1.3",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node",
    "testTimeout": 60000,
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ]
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
